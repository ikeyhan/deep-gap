<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Atom" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- اسپلش سیستمی (API 31+ بومی، قدیمی‌تر با core-splashscreen): فقط تا آماده‌شدن اولین فریم -->
    <style name="Theme.Atom.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Atom</item>
    </style>
</resources>
