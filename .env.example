# ============================================================
# Deep Gap (دیپ گپ) — Environment Configuration Example
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# ---- App ----
APP_NAME=DeepGap
APP_ENV=development           # development | staging | production
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-please-use-a-long-random-string

# ---- Database (PostgreSQL) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=deepgap
POSTGRES_PASSWORD=deepgap_dev_password
POSTGRES_DB=deepgap
# Async SQLAlchemy URL (used by the app). Compose builds it from the parts above.
DATABASE_URL=postgresql+asyncpg://deepgap:deepgap_dev_password@postgres:5432/deepgap

# ---- Redis (cache / rate limit / queue) ----
REDIS_URL=redis://redis:6379/0

# ---- JWT / Auth ----
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- OTP ----
OTP_LENGTH=5
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PROVIDER=console          # console | kavenegar | twilio ...
OTP_PROVIDER_API_KEY=

# ---- Object Storage (S3-compatible / MinIO) ----
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=deepgap
S3_SECRET_KEY=deepgap_dev_password
S3_BUCKET=deepgap
S3_REGION=us-east-1

# ---- AI Providers (server-side ONLY, never shipped to the app) ----
# Keys are optional in dev — the built-in "echo" mock provider works without them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Generic provider base URLs (override per-provider as needed)
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Payments (server-side verification required) ----
PAYMENT_PROVIDER=mock         # mock | zarinpal | bazaar | myket ...
PAYMENT_CALLBACK_URL=http://localhost:8000/api/v1/payments/callback
ZARINPAL_MERCHANT_ID=

# ---- Notifications (FCM) ----
FCM_CREDENTIALS_JSON=

# ---- Monitoring ----
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=true

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
